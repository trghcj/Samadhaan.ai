# Copy this file to backend/.env (the real .env is git-ignored) and adjust.

# Local demo database (a file created next to main.py). For the deployed site use the PostgreSQL address from Render instead.
DATABASE_URL=sqlite:///demo.db

# Speech to text. "small" answers in about 3 s per complaint on a laptop CPU; "large-v3-turbo" is more accurate but about 10 s.
WHISPER_MODEL=small
WHISPER_COMPUTE=int8
WHISPER_THREADS=4
WHISPER_LANGUAGE=auto

# 1 keeps every uploaded recording in backend/temp_audio (useful for collecting test recordings). Leave unset to delete them after use.
# KEEP_AUDIO=1

# Optional: only used if the MuRIL model is missing (fallback classifier). Not needed for the normal demo.
# GEMINI_API_KEY=

# Optional: WHISPER_PROMPT=civic turns on a vocabulary hint (it slowed Whisper a lot on real recordings), PRELOAD_MODELS=0 loads models lazily.
